<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="400.0"
        prefWidth="600.0"
        stylesheets="@/styles/groupmember.css"
        styleClass="root-pane"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1">

    <center>

        <VBox alignment="TOP_CENTER"
              spacing="15"
              styleClass="main-container"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- TITLE -->
            <HBox alignment="CENTER">
                <children>
                    <Label text="GROUP MEMBER NAME AND ID"
                           styleClass="title-label"/>
                </children>
            </HBox>

            <!-- HEADER -->
            <HBox alignment="CENTER"
                  spacing="100"
                  styleClass="header-box">

                <children>
                    <Label text="NAME"
                           styleClass="header-label"/>

                    <Label text="ID"
                           styleClass="header-label"/>
                </children>
            </HBox>

            <!-- MEMBERS -->
            <HBox alignment="CENTER">

                <children>

                    <GridPane hgap="80"
                              vgap="12"
                              styleClass="member-grid">

                        <columnConstraints>
                            <ColumnConstraints prefWidth="220"/>
                            <ColumnConstraints prefWidth="120"/>
                        </columnConstraints>

                      <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>

                        <children>

                            <!-- Names -->
                            <Label text="Dagmawit Mesfin"
                                   styleClass="member-label"/>

                            <Label text="02065/16"
                                   styleClass="id-label"
                                   GridPane.columnIndex="1"/>

                            <Label text="Alemu Getu"
                                   styleClass="member-label"
                                   GridPane.rowIndex="1"/>

                            <Label text="01821/16"
                                   styleClass="id-label"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                            <Label text="Amanuel Muluken"
                                   styleClass="member-label"
                                   GridPane.rowIndex="2"/>

                            <Label text="01811/16"
                                   styleClass="id-label"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>

                            <Label text="Helen Birhan"
                                   styleClass="member-label"
                                   GridPane.rowIndex="3"/>

                            <Label text="01955/16"
                                   styleClass="id-label"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3"/>

                            <Label text="Abel Mulu"
                                   styleClass="member-label"
                                   GridPane.rowIndex="4"/>

                            <Label text="01825/16"
                                   styleClass="id-label"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="4"/>

                            <Label text="Nephtalem"
                                   styleClass="member-label"
                                   GridPane.rowIndex="5"/>

                            <Label text="00363/16"
                                   styleClass="id-label"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="5"/>
                            
                            <Label text="Abdulhamid Nurhusein"
                                   styleClass="member-label"
                                   GridPane.rowIndex="6"/>

                            <Label text="01688/15"
                                   styleClass="id-label"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="6"/>

                        </children>
                    </GridPane>

                </children>

            </HBox>

        </VBox>

    </center>

</BorderPane>