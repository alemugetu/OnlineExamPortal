<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0"
            prefWidth="1100.0"
            styleClass="root-container"
            stylesheets="@/styles/studentresult.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.onlineexamproject.StudentResultListController">
    <!-- HEADER -->
    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              styleClass="navbar">

            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>

            <Button text=" Back"
                    styleClass="nav-button-back"
                    onAction="#handleBack"/>

            <Label text="My Results"
                   styleClass="page-title"/>
        </HBox>
    </top>

    <!-- BODY -->
    <center>

        <ScrollPane fitToWidth="true"
                    styleClass="content-scrollpane">

            <content>

                <VBox spacing="30"
                      styleClass="main-content">

                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>
                    <children>

                    <FlowPane fx:id="resultContainer"
                              hgap="25"
                              vgap="25"
                              prefWrapLength="900"/>
                    </children>

                </VBox>

            </content>
        </ScrollPane>

    </center>

</BorderPane>