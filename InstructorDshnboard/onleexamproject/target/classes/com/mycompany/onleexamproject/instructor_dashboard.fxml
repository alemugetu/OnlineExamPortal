<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" 
            stylesheets="@/styles/instructor_dashboard.css" 
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.onleexamproject.Instructor_dashboardController">
    
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="header-bar">
            <padding><Insets left="30" right="30" /></padding>
            <children>
                <ImageView fitHeight="50.0" fitWidth="50.0" preserveRatio="true">
                    <image>
                        <Image url="@images/logo.jpg" />
                     </image>
                </ImageView>
                <Label styleClass="logo-text" text="UoG Portal" />

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="10">
                    <children>

                        <MenuButton fx:id="staffMenu" styleClass="profile-menu" >
                            <items>
                                <MenuItem text="Group Members" onAction="#groupMember" />
                                <SeparatorMenuItem />
                                <MenuItem styleClass="logout-item" text="Logout" onAction="#handleLogout" fx:id="logoutButton" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
            </children>
        </HBox>
   </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>

        <TabPane id="mainTabPane" fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <!-- ================= DASHBOARD TAB ================= -->
                <Tab text="Dashboard">
                    <content>
                        <VBox spacing="15">
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>

                            <children>

                                <Label style="-fx-font-size:24px; -fx-font-weight:bold;" 
                                       text="Instructor Dashboard" />

                                <HBox spacing="15">

                                    <VBox prefWidth="200" style="-fx-background-color:#ecf0f1; -fx-padding:15;">
                                        <children>
                                            <Label prefHeight="17.0" prefWidth="86.0" text="Create Exam" />
                                            <Button fx:id="btnCreateExam" mnemonicParsing="false" onAction="#goToCreateExam" prefHeight="25.0" prefWidth="84.0" text="go -&gt;" />
                                        </children>
                                    </VBox>
                                    

                                    <VBox prefWidth="200" style="-fx-background-color:#ecf0f1; -fx-padding:15;">
                                        <children>
                                            <Label prefHeight="17.0" prefWidth="81.0" text="View Result" />
                                            <Button fx:id="btnViewResults" mnemonicParsing="false" onAction="#goToResults" prefHeight="25.0" prefWidth="84.0" text="go -&gt;" />
                                        </children>
                                    </VBox>

                                </HBox>

                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- ================= CREATE EXAM TAB ================= -->
                <Tab fx:id="createExamTab" text="Create Exam">
                    <content>
                        <ScrollPane fitToWidth="true">
                            <content>
                                <VBox spacing="15">
                                    <padding>
                                        <Insets bottom="20" left="20" right="20" top="20" />
                                    </padding>

                                    <children>

                                        <Label style="-fx-font-size:24px; -fx-font-weight:bold;" text="Create New Exam" />

                                              <!-- Exam Information -->
                                        <GridPane hgap="10" vgap="10">
                                            <children>

                                                      <Label text="Course:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                      <ComboBox fx:id="courseComboBox" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                      <Label text="Exam Title:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                      <TextField fx:id="txtExamTitle" promptText="Exam title" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                      <Label text="Time Limit:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                      <TextField fx:id="txtTimeLimit" promptText="Minutes" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                      <Label text="Total Marks:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                      <TextField fx:id="txtTotalMarks" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                                      <Label text="Exam Date:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                                      <DatePicker fx:id="examDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                      
                                                       <Label prefHeight="17.0" prefWidth="79.0" text="Exam Code" GridPane.rowIndex="5" />
                                                       <TextField fx:id="txtExamCode" promptText="Course Code" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                            </children>
                                 <columnConstraints>
                                    <ColumnConstraints />
                                    <ColumnConstraints />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" />
                                 </rowConstraints>
                                        </GridPane>

                                        <!-- Multiple Choice Question -->
                                        <TitledPane expanded="true" text="Add Multiple Choice Question">
                                            <content>
                                                <VBox spacing="10">

                                                    <TextField fx:id="txtQuestion" promptText="Question" />

                                                    <TextField fx:id="txtOptionA" promptText="Option A" />

                                                    <TextField fx:id="txtOptionB" promptText="Option B" />

                                                    <TextField fx:id="txtOptionC" promptText="Option C" />

                                                    <TextField fx:id="txtOptionD" promptText="Option D" />
                                       <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="1025.0">
                                          <children>
      
                                             <ComboBox fx:id="correctAnswerComboBox" promptText="Correct Answer" />
                                             <Label alignment="CENTER" prefHeight="17.0" prefWidth="61.0" text="Mark" />
                                             <TextField fx:id="txtQnMark" promptText="e.g 1pts" text="1" />
                                          </children>
                                       </HBox>

                                                    <HBox spacing="10">
                                                        <children>
                                                            <Button onAction="#handleAddQuestion" text="Add Question" />

                                                            <Button onAction="#handleClearQuestion" text="Clear" />
                                                        </children>
                                                    </HBox>

                                                </VBox>
                                            </content>
                                        </TitledPane>
                                        
                                        <!-- Question Table -->
                                        <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Added Questions" />

                                        <TableView fx:id="questionTable" prefHeight="250">
                                            <columns>
                                                <TableColumn fx:id="colQId" prefWidth="70" text="ID" />
                                                <TableColumn fx:id="colQContent" prefWidth="500" text="Question" />
                                                <TableColumn fx:id="colQAnswer" prefWidth="150" text="Answer" />
                                                <TableColumn fx:id="colQAction" prefWidth="120" text="Action" />
                                            </columns>
                                        </TableView>

                                        <HBox spacing="10">
                                            <children>
                                                <Button onAction="#handleClearForm" text="Clear Form" />

                                                <Button onAction="#handlePublishExam" text="Publish Exam" />
                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- ================= RESULTS TAB ================= -->
                <Tab fx:id="resultsTab" text="Results">

                    <content>

                        <BorderPane styleClass="page-container">

                            <!-- TOP HEADER -->
                            <top>

                                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding:15;">

                                    <children>

                                        <VBox spacing="3">

                                            <children>

                                                <Label style="-fx-font-size:24px;
                                                              -fx-font-weight:bold;" text="Exam Results" />

                                                <Label style="-fx-text-fill:#7f8c8d;" text="Select an exam to view all student scores" />

                                            </children>

                                        </VBox>

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Button onAction="#loadAvailableExams" text="Refresh" />

                                    </children>

                                </HBox>

                            </top>

                            <!-- LEFT SIDE : EXAM LIST -->
                            <left>

                                <VBox prefWidth="280" spacing="10" style="-fx-padding:15;                                              
                                               -fx-background-color:#f8f9fa;                                             
                                                -fx-border-color:#e0e0e0;">

                                    <children>

                                        <Label style="-fx-font-size:18px;          
                                                 -fx-font-weight:bold;" text="Available Exams" />

                                        <ListView fx:id="examListView" VBox.vgrow="ALWAYS" />

                                    </children>

                                </VBox>

                            </left>

                            <!-- CENTER : RESULT TABLE -->
                            <center>

                                <VBox spacing="10" style="-fx-padding:15;">

                                    <children>

                                        <Label fx:id="lblSelectedExam" style="-fx-font-size:20px;                                                       
                                                      -fx-font-weight:bold;" text="Select an exam" />

                                        <TableView fx:id="resultTable" styleClass="modern-table" VBox.vgrow="ALWAYS">

                                            <columns>

                                                <TableColumn fx:id="colStudentName" prefWidth="400.0000203847885" text="Student Name" />

                                                <TableColumn fx:id="colStudentId" prefWidth="209.99996948242188" text="Student ID" />

                                                <TableColumn fx:id="colStudentScore" prefWidth="179.3333740234375" text="Score" />

                                            </columns>

                                        </TableView>

                                    </children>

                                </VBox>

                            </center>

                        </BorderPane>

                    </content>

                </Tab>

            </tabs>
        </TabPane>

    </center>
</BorderPane>
